# ═══════════════════════════════════════════════════════════════════════════
# itoolbox-web — STAGING environment. Compose settings only; no secrets.
#
# In the staging checkout (C:\IToolbox\staging\itoolbox-frontend) copy this to
# .env. Production's checkout has no .env and keeps every default in compose.yaml,
# so nothing here can reach it. These are compose-level values, not Next's: the
# build args in compose.yaml carry them into the static export.
# ═══════════════════════════════════════════════════════════════════════════

# Keeps staging's project, container and image apart from production's.
COMPOSE_PROJECT_NAME=itoolbox_staging_frontend
ENV_SUFFIX=-staging

# Binds to 127.0.0.1 only. Tailscale Serve publishes it on :8443
# (itoolbox-backend/docs/ENVIRONMENTS.md).
WEB_PORT=3110

# Shown as a label in the corner of every page. Anything but "production" turns it on.
APP_ENV=staging

# Staging's API, on the same host the page was opened at, so one build works at
# localhost and over Tailscale.
NEXT_PUBLIC_API_PORT=8110
# NEXT_PUBLIC_API_URL=      # only if the staging API runs on another machine
